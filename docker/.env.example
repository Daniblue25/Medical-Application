# =============================================================================
# Exemple de variables d'environnement pour le conteneur Docker
# Copier ce fichier : cp .env.example .env  puis adapter les valeurs
# =============================================================================

# --- Django ---
DEBUG=false
DJANGO_SECRET_KEY=CHANGE-ME-generate-a-real-secret-key
ALLOWED_HOSTS=*

# --- CSRF (mettre l'URL Cloud Run une fois déployé) ---
CSRF_TRUSTED_ORIGINS=https://medsearch-XXXXXX-ew.a.run.app

# --- Base de données ---
# SQLite par défaut (ok pour test, données non persistantes sur Cloud Run)
# Pour PostgreSQL (Cloud SQL) décommenter :
# DATABASE_URL=postgres://user:password@/dbname?host=/cloudsql/PROJECT:REGION:INSTANCE

# --- Cache ---
# Pas de Redis par défaut en test ; le cache local mémoire est utilisé
# REDIS_URL=redis://10.0.0.3:6379/1

# --- Gunicorn ---
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# --- Sécurité ---
SECURE_SSL_REDIRECT=false
# Activer en production si le domaine a HTTPS :
# SECURE_SSL_REDIRECT=true
