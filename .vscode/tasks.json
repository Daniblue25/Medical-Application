{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Flask App",
			"type": "shell",
			"command": "python",
			"args": [
				"run.py"
			],
			"group": "build",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Start Django Server",
			"type": "shell",
			"command": "python",
			"args": [
				"manage.py",
				"runserver"
			],
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Django Server with venv",
			"type": "shell",
			"command": ".\\venv\\Scripts\\python.exe",
			"args": [
				"manage.py",
				"runserver"
			],
			"isBackground": true,
			"group": "build"
		}
	]
}